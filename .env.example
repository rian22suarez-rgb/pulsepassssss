# Copia este archivo a .env (que NO debe subirse a git) y rellena los valores
# El valor debe ser Base64 de al menos 32 bytes aleatorios.

PULSEPASS_JWT_SECRET_BASE64=<tu-secreto-base64-de-al-menos-32-bytes>
PULSEPASS_JWT_ISSUER=pulsepass-api
PULSEPASS_JWT_TTL=900000

# Base de datos (opcional, tiene defaults en application.properties)
DB_USERNAME=postgres
DB_PASSWORD=123